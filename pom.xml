    <groupId>org.example</groupId>
    <artifactId>e2e-encrypted-media-serv</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>e2e-encrypted-media-serv</name>

    <description>Spring Boot service with PostgreSQL, MinIO and Flyway</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- FOR SPRING V4 -->
